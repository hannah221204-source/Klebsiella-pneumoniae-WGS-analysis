## Download Bowtie2
wget https://sourceforge.net/projects/bowtie-bio/files/bowtie2/2.5.4/bowtie2-2.5.4-linux-x86_64.zip/download -O bowtie2-2.5.4-linux-x86_64.zip
## Run Bowtie2 using slurm job
# Index human reference
nano run_homosapiens_index.sh
  #!/bin/bash
  #SBATCH --job-name=bt2_index
  #SBATCH --cpus-per-task=8
  #SBATCH --mem=32G
  #SBATCH --time=08:00:00
  #SBATCH --output=bt2_index_%j.out
  #SBATCH --error=bt2_index_%j.err
  export PATH=/mnt/18T/nhienhuong/bowtie2/bowtie2-2.5.2-linux-x86_64:$PATH
  bowtie2-build homosapiens.fa.gz host_index
# Submit job
sbatch run_homosapiens_index.sh
# Check job state
sacct -j %j
# Align reads on host index
nano run_bowtie2.sh
  #!/bin/bash
  #SBATCH --job-name=host_removal
  #SBATCH --cpus-per-task=8
  #SBATCH --mem=32G
  #SBATCH --threads=4
  #SBATCH --time=04:00:00
  #SBATCH --output=host_removal_302.out
  #SBATCH --error=host_removal_302.err
  export PATH=/mnt/18T/nhienhuong/bowtie2/bowtie2-2.5.2-linux-x86_64:$PATH
  # Input
  R1=302_1_fastp.fq.gz
  R2=302_2_fastp.fq.gz
  # Index prefix
  INDEX=host_index
  # Output
  OUT_PREFIX=nohost_302
  # Run Bowtie2
  bowtie2 \
    -x $INDEX \
    -1 $R1 -2 $R2 \
    --threads 4 \
    --very-sensitive \
    --un-conc-gz ${OUT_PREFIX}_%.fastq.gz \
    -S /dev/null 
sbatch run_bowtie2.sh
